+
+// Peak-constrained VBR must retain both its average and peak after scenario
+// and media-type negotiation. A prepared replacement may fail without touching
+// the application's current encoder; never silently fall back to another RC.
+static int mf_repc_apply_rate_control(AVCodecContext *avctx)
+{
+    MFContext *c = avctx->priv_data;
+    const GUID *properties[] = {
+        &ff_CODECAPI_AVEncCommonRateControlMode,
+        &ff_CODECAPI_AVEncCommonMeanBitRate,
+        &ff_CODECAPI_AVEncCommonMaxBitRate,
+    };
+    uint32_t desired[3];
+    const int count = c->repc_require_cbr ? 1 : 3;
+
+    if (!c->repc_require_cbr && c->opt_enc_rc != ff_eAVEncCommonRateControlMode_PeakConstrainedVBR)
+        return 0;
+    if (!c->codec_api || (c->repc_require_cbr && c->opt_enc_rc != ff_eAVEncCommonRateControlMode_CBR))
+        return AVERROR(EINVAL);
+    if (!c->repc_require_cbr && (avctx->bit_rate <= 0 ||
+        avctx->rc_max_rate < avctx->bit_rate || avctx->rc_max_rate > UINT32_MAX))
+        return AVERROR(EINVAL);
+    desired[0] = c->repc_require_cbr ? ff_eAVEncCommonRateControlMode_CBR :
+        ff_eAVEncCommonRateControlMode_PeakConstrainedVBR;
+    desired[1] = avctx->bit_rate;
+    desired[2] = avctx->rc_max_rate;
+    for (int i = 0; i < count; ++i) {
+        HRESULT hr = ICodecAPI_SetValue(c->codec_api, properties[i], FF_VAL_VT_UI4(desired[i]));
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "MF rate-control property %d rejected: %s\n", i, ff_hr_str(hr));
+            return AVERROR(ENOSYS);
+        }
+    }
+    for (int i = 0; i < count; ++i) {
+        VARIANT actual = { 0 };
+        HRESULT hr = ICodecAPI_GetValue(c->codec_api, properties[i], &actual);
+        int matches = SUCCEEDED(hr) && actual.vt == VT_UI4 && actual.ulVal == desired[i];
+        VariantClear(&actual);
+        if (!matches) {
+            av_log(avctx, AV_LOG_ERROR, "MF rate-control property %d readback rejected\n", i);
+            return AVERROR(ENOSYS);
+        }
+    }
+    return 0;
+}
 
