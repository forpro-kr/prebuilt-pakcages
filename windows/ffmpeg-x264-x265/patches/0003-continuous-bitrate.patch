+/* RePC opt-in contract: update existing AMF properties before taking an input
+ * frame. A failed transaction either restores verified properties or poisons
+ * the session; submitting with an unknown rate-control state is not allowed. */
+static int repc_amf_get_rate(AMFComponent *encoder, const wchar_t *name, int64_t *value)
+{
+    AMFVariantStruct var = { 0 };
+    AMF_RESULT res = encoder->pVtbl->GetProperty(encoder, name, &var);
+    int valid = res == AMF_OK && var.type == AMF_VARIANT_INT64;
+    if (valid)
+        *value = var.int64Value;
+    AMFVariantClear(&var);
+    return valid ? 0 : AVERROR_EXTERNAL;
+}
+
+static int repc_amf_set_rate(AMFComponent *encoder, const wchar_t *name, int64_t value)
+{
+    AMFVariantStruct var = { 0 };
+    AMFVariantAssignInt64(&var, value);
+    return encoder->pVtbl->SetProperty(encoder, name, var) == AMF_OK ? 0 : AVERROR_EXTERNAL;
+}
+
+static void repc_amf_rate_names(AVCodecContext *avctx, const wchar_t **target, const wchar_t **peak)
+{
+    const int hevc = avctx->codec_id == AV_CODEC_ID_HEVC;
+    *target = hevc ? AMF_VIDEO_ENCODER_HEVC_TARGET_BITRATE : AMF_VIDEO_ENCODER_TARGET_BITRATE;
+    *peak   = hevc ? AMF_VIDEO_ENCODER_HEVC_PEAK_BITRATE : AMF_VIDEO_ENCODER_PEAK_BITRATE;
+}
+
+void ff_amf_repc_init_bitrate(AVCodecContext *avctx)
+{
+    AMFEncoderContext *ctx = avctx->priv_data;
+    const wchar_t *target, *peak;
+    repc_amf_rate_names(avctx, &target, &peak);
+    if (repc_amf_get_rate(ctx->encoder, target, &ctx->repc_applied_bitrate) < 0)
+        ctx->repc_applied_bitrate = 0;
+    if (repc_amf_get_rate(ctx->encoder, peak, &ctx->repc_applied_peak_rate) < 0)
+        ctx->repc_applied_peak_rate = 0;
+}
+
+static int repc_amf_update_bitrate(AVCodecContext *avctx)
+{
+    AMFEncoderContext *ctx = avctx->priv_data;
+    const wchar_t *target, *peak;
+    int64_t old_target, old_peak, actual_target, actual_peak;
+    int64_t requested_peak;
+    int rollback_target, rollback_peak, updated;
+
+    if (!ctx->repc_continuous_bitrate)
+        return 0;
+    if (ctx->repc_applied_bitrate < 0)
+        return AVERROR_EXTERNAL;
+    if (avctx->bit_rate <= 0)
+        return AVERROR(EINVAL);
+    requested_peak = FFMAX(avctx->rc_max_rate, avctx->bit_rate);
+    if (ctx->repc_applied_bitrate == avctx->bit_rate && ctx->repc_applied_peak_rate == requested_peak)
+        return 0;
+    repc_amf_rate_names(avctx, &target, &peak);
+    if (repc_amf_get_rate(ctx->encoder, target, &old_target) < 0 ||
+        repc_amf_get_rate(ctx->encoder, peak, &old_peak) < 0)
+        return AVERROR_EXTERNAL;
+    ctx->repc_applied_bitrate = old_target;
+    ctx->repc_applied_peak_rate = old_peak;
+    if (old_target == avctx->bit_rate && old_peak == requested_peak)
+        return 0;
+    if ((avctx->codec_id == AV_CODEC_ID_H264 && ctx->rate_control_mode == AMF_VIDEO_ENCODER_RATE_CONTROL_METHOD_CONSTANT_QP) ||
+        (avctx->codec_id == AV_CODEC_ID_HEVC && ctx->rate_control_mode == AMF_VIDEO_ENCODER_HEVC_RATE_CONTROL_METHOD_CONSTANT_QP))
+        return AVERROR(ENOSYS);
+
+    /* Keep VBV and static initialization properties unchanged. Lower target
+     * first on a decrease, raise peak first on an increase. No IDR is requested. */
+    if (avctx->bit_rate < old_target)
+        updated = repc_amf_set_rate(ctx->encoder, target, avctx->bit_rate) == 0 &&
+                  repc_amf_set_rate(ctx->encoder, peak, requested_peak) == 0;
+    else
+        updated = repc_amf_set_rate(ctx->encoder, peak, requested_peak) == 0 &&
+                  repc_amf_set_rate(ctx->encoder, target, avctx->bit_rate) == 0;
+    if (updated &&
+        repc_amf_get_rate(ctx->encoder, target, &actual_target) == 0 &&
+        repc_amf_get_rate(ctx->encoder, peak, &actual_peak) == 0 &&
+        actual_target == avctx->bit_rate && actual_peak == requested_peak) {
+        ctx->repc_applied_bitrate = actual_target;
+        ctx->repc_applied_peak_rate = actual_peak;
+        return 0;
+    }
+
+    /* Both setters must run even if the first rollback fails. */
+    if (avctx->bit_rate < old_target) {
+        rollback_peak   = repc_amf_set_rate(ctx->encoder, peak, old_peak);
+        rollback_target = repc_amf_set_rate(ctx->encoder, target, old_target);
+    } else {
+        rollback_target = repc_amf_set_rate(ctx->encoder, target, old_target);
+        rollback_peak   = repc_amf_set_rate(ctx->encoder, peak, old_peak);
+    }
+    if (rollback_target == 0 && rollback_peak == 0 &&
+        repc_amf_get_rate(ctx->encoder, target, &actual_target) == 0 &&
+        repc_amf_get_rate(ctx->encoder, peak, &actual_peak) == 0 &&
+        actual_target == old_target && actual_peak == old_peak) {
+        avctx->bit_rate = old_target;
+        avctx->rc_max_rate = old_peak;
+        av_log(avctx, AV_LOG_ERROR, "AMF live bitrate update rejected; previous properties restored\n");
+    } else {
+        ctx->repc_applied_bitrate = -1;
+        av_log(avctx, AV_LOG_ERROR, "AMF live bitrate rollback failed; encoder state is unknown\n");
+    }
+    return AVERROR_EXTERNAL;
+}
